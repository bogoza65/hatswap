{
  "manifest_version": 3,
  "name": "Hatswap",
  "version": "1.5.0",
  "description": "Switch between saved accounts on the same website with one click. Sessions are encrypted and never leave your computer.",
  "minimum_chrome_version": "120",
  "permissions": ["cookies", "storage", "scripting", "activeTab", "tabs"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hatswap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "switch-next": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Switch to the next account on this site"
    },
    "switch-previous": {
      "description": "Switch to the previous account on this site"
    },
    "_execute_action": {
      "description": "Open Hatswap"
    }
  }
}
